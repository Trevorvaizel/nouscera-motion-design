      "id": "54f0c84a-cda5-483f-973d-30afdbb4c002",
      "name": "Validate evidence and creative boundary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "const id=$('Coordinator submits completed audit').first().json.body.run_id; if(typeof id!=='string'||! /^[a-f0-9]{16}$/.test(id))throw Error('Invalid run ID'); const run=$json.runs.find(x=>x.run_id===id); if(!run||run.status!=='complete'||run.completed.join(',')!=='source,krita,layers,board,gate,receipt'||run.creative_approval!==false)throw Error('Incomplete or unauthorized run');const a=run.results;if(a.gate.scene_id!=='CP05'||a.gate.status!=='blocked'||a.gate.errors.length||a.receipt.readiness!=='blocked'||a.receipt.creative_approval!==false)throw Error('Only blocked CP05 audits are registered');if(a.board.sha256!=='a10960beeea47ac49dc097505ee30dad673c498e568baa91e598d5c6766f066a')throw Error('Changed board requires separate version review');return [{json:{run_id:id,marker:'NOUSCERA preparation audit '+id,blockers:a.gate.blockers,board_sha256:a.board.sha256,receipt:a.receipt,task_id:'645ce68b-2537-46e9-9ba9-c54ac81ca6c9',blocked_status:'213345eb-accb-405e-b48e-76234e772a4f',existing_preview_id:'60eddeb4-58c8-4296-97fa-fe563ce9f838'}}];"
      }
    },
