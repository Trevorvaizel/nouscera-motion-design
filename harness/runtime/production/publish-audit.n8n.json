      "parameters": {
        "jsCode": "const v=$('Validate evidence and creative boundary').first().json;const item=$input.first();if(!item.binary?.data)throw Error('Receipt file missing');item.binary.data.fileName='CP05-preparation-audit-'+v.run_id+'.json';item.binary.data.mimeType='application/json';item.json={...v,comment:v.marker+'\\nTechnical audit only; no creative approval. Readiness remains BLOCKED.\\n'+v.blockers.join('\\n')+'\\nExisting diagnostic board version reused (unchanged SHA256 '+v.board_sha256+'). Native n8n execution: '+$execution.id+'.\\nThe audit receipt is attached. No new motion or repair performed.'};return [item];"
      }
