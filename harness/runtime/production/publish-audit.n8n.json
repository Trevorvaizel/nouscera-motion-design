        "jsCode": "const v=$('Validate evidence and creative boundary').first().json;const prior=$('Check audit publication identity').first().json;const list=$json.body;const hits=list.filter(x=>typeof x.text==='string'&&x.text.includes(v.marker));if(hits.length!==1)throw Error('Audit publication missing or duplicated');const c=hits[0];if(c.task_status_id!==v.blocked_status||!c.attachment_files?.length)throw Error('Publication missing blocked status or receipt attachment');return [{json:{run_id:v.run_id,comment_id:c.id,attachment_count:c.attachment_files.length,existing_preview_id:v.existing_preview_id,publication:prior.already_published?'reused':'created',creative_approval:false,readiness:'blocked',n8n_execution_id:$execution.id,task_url:'http://127.0.0.1:8080/productions/c5bd5a65-21b0-4e1a-8459-b6b87344cfd7/shots/tasks/645ce68b-2537-46e9-9ba9-c54ac81ca6c9/'}}];"
